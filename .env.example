# Copia este archivo como .env y complétalo. .env está en .gitignore: nunca lo subas.
# Solo lo leen scripts/deploy-testnet.mjs y scripts/seal-testnet.mjs. El navegador no lo recibe.

# RPC de Sepolia con permiso de escritura (Alchemy, Infura u otro proveedor).
SEPOLIA_RPC_URL=

# Llave privada de una wallet de PRUEBA creada solo para esto (0x + 64 hex). Sin fondos reales.
SELLADOR_PRIVATE_KEY=

# Opcional: para verificar el código fuente del contrato en sepolia.etherscan.io.
ETHERSCAN_API_KEY=

# Opcional: RPC público de solo lectura que usará el navegador para verificar.
# Por defecto: https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PUBLIC_RPC_URL=
